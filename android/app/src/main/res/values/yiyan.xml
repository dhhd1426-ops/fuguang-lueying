<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="yiyan_widget_desc">手记里你写的一言，每 2 小时换一句</string>
    <style name="YiyanLine">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:gravity">center_vertical|start</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:fontFamily">serif</item>
        <item name="android:textColor">#F6F4F0</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
        <item name="android:shadowColor">#59000000</item>
        <item name="android:shadowDy">1</item>
        <item name="android:shadowRadius">8</item>
        <item name="android:autoSizeTextType">uniform</item>
        <item name="android:autoSizeMinTextSize">12sp</item>
        <item name="android:autoSizeMaxTextSize">40sp</item>
        <item name="android:autoSizeStepGranularity">1sp</item>
        <item name="android:text">在手记里写下第一句</item>
    </style>
</resources>
